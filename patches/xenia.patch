+namespace {
+// scRGB (linear, extended) to an 8-bit sRGB byte for captures.
+uint32_t ScRgbToSrgbByte(uint16_t half, float scale) {
+  uint32_t bits = uint32_t(half & 0x7FFF) << 13;
+  float value;
+  if ((half & 0x7C00) == 0) {
+    value = float(half & 0x3FF) * (1.0f / 16777216.0f);
+  } else {
+    bits += (127 - 15) << 23;
+    std::memcpy(&value, &bits, sizeof(value));
+  }
+  if (half & 0x8000) value = 0.0f;
+  value = std::min(value * scale, 1.0f);
+  value = value <= 0.0031308f ? value * 12.92f
+                              : 1.055f * std::pow(value, 1.0f / 2.4f) - 0.055f;
+  return uint32_t(value * 255.0f + 0.5f);
+}
