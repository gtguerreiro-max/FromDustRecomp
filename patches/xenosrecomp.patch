+float fdVertexComponent(uint value, uint bits, bool isSigned, bool isInteger)
+{
+    float v = float(value);
+    if (isSigned)
+        v = float(int(value << (32 - bits)) >> (32 - bits));
+    if (!isInteger)
+        v = isSigned ? max(v / float((1u << (bits - 1)) - 1), -1.0) : v / float((1u << bits) - 1);
